pipeline {
    agent any
    stages {
        stage('Checkout') {
            steps { checkout scm }
        }
        stage('Install dependencies') {
            steps {
                sh 'python3 -m venv .venv'
                sh '.venv/bin/pip install -r requirements.txt'
            }
        }
        stage('Validate application') {
            steps {
                sh '.venv/bin/python -m py_compile app.py'
                sh '.venv/bin/python -c "from app import app; c=app.test_client(); assert c.get(\'/health\').status_code == 200; r=c.post(\'/chat\', json={\'message\':\'thanks\'}); assert r.status_code == 200 and \'Welcome\' in r.get_json()[\'reply\']; print(\'Flask tests passed\')"'
            }
        }
        stage('Docker build') {
            steps { sh 'docker build -t sanskrit-saathi-chatbot:latest .' }
        }
    }
    post {
        success { echo 'Sanskrit Saathi CI pipeline completed successfully.' }
        failure { echo 'Pipeline failed. Check the stage logs above.' }
    }
}
